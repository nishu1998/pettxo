rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function requesterUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function requesterHasUserDoc() {
      return signedIn() && exists(requesterUserPath());
    }

    function requesterAccountIsActive() {
      return signedIn() &&
        requesterHasUserDoc() &&
        (
          !get(requesterUserPath()).data.keys().hasAny(['accountStatus']) ||
          get(requesterUserPath()).data.accountStatus == 'active'
        );
    }

    function requesterAccountMissingOrActive() {
      return signedIn() &&
        (
          !requesterHasUserDoc() ||
          !get(requesterUserPath()).data.keys().hasAny(['accountStatus']) ||
          get(requesterUserPath()).data.accountStatus == 'active'
        );
    }

    function validNormalizedUsername(username) {
      return username is string &&
        username.matches('^[a-z0-9_.]{3,20}$') &&
        !username.matches('^\\..*') &&
        !username.matches('.*\\.$') &&
        !username.matches('.*\\.\\..*') &&
        !(username in [
          'admin',
          'administrator',
          'api',
          'auth',
          'help',
          'me',
          'notifications',
          'pettxo',
          'root',
          'security',
          'settings',
          'signin',
          'signup',
          'support',
          'system',
          'user',
          'username'
        ]);
    }

    function usernameReservationPath(normalizedUsername) {
      return /databases/$(database)/documents/usernames/$(normalizedUsername);
    }

    function usernameFieldsConsistent(data) {
      return data.username is string &&
        data.usernameLowercase is string &&
        data.username == data.usernameLowercase &&
        validNormalizedUsername(data.usernameLowercase);
    }

    function usernameReservationMatchesUser(userId, normalizedUsername) {
      return existsAfter(usernameReservationPath(normalizedUsername)) &&
        getAfter(usernameReservationPath(normalizedUsername)).data.uid == userId &&
        getAfter(usernameReservationPath(normalizedUsername)).data.username == normalizedUsername &&
        getAfter(usernameReservationPath(normalizedUsername)).data.usernameLowercase == normalizedUsername;
    }

    function usernameReservationBackedByUserDoc(userId, normalizedUsername) {
      return existsAfter(/databases/$(database)/documents/users/$(userId)) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == userId &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.username == normalizedUsername &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.usernameLowercase == normalizedUsername;
    }

    function previousUsernameReleasedIfChanged(userId) {
      return !resource.data.keys().hasAny(['usernameLowercase']) ||
        request.resource.data.usernameLowercase == resource.data.usernameLowercase ||
        !existsAfter(usernameReservationPath(resource.data.usernameLowercase)) ||
        getAfter(usernameReservationPath(resource.data.usernameLowercase)).data.uid != userId;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole in [
          "superAdmin",
          "customerSupportAdmin",
          "financeAdmin"
        ];
    }

    function canModerateSocialContent() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole in [
            "superAdmin",
            "customerSupportAdmin"
          ] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canModerateReports == true
        );
    }

    function canMonitorChats() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole in [
          "superAdmin",
          "customerSupportAdmin"
        ];
    }

    function canReviewProviderVerification() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole in [
          "superAdmin",
          "customerSupportAdmin"
        ];
    }

    function canManageSupportTickets() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole in [
          "superAdmin",
          "customerSupportAdmin"
        ];
    }

    function existingOwnerId() {
      return resource.data.ownerUserId;
    }

    function chatParticipant(chatData) {
      return signedIn() &&
        request.auth.uid in chatData.participantIds;
    }

    function directUserChatParticipantIdsValid() {
      return request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds[0] is string &&
        request.resource.data.participantIds[1] is string &&
        request.resource.data.participantIds[0] != request.resource.data.participantIds[1];
    }

    function safeDirectUserChatCreate(chatId) {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'chatType',
        'customerId',
        'providerId',
        'participantIds',
        'participantSnapshots',
        'customerName',
        'customerPhotoUrl',
        'providerName',
        'providerPhotoUrl',
        'sourceServiceIds',
        'lastServiceId',
        'lastServiceTitle',
        'lastServiceImageUrl',
        'lastMessage',
        'lastMessageAt',
        'lastSenderId',
        'unreadCountCustomer',
        'unreadCountProvider',
        'customerLastReadAt',
        'providerLastReadAt',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.chatType == 'directUser' &&
      directUserChatParticipantIdsValid() &&
      request.resource.data.customerId == request.resource.data.participantIds[0] &&
      request.resource.data.providerId == request.resource.data.participantIds[1] &&
      chatId == ('direct_' + request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]) &&
      request.resource.data.participantSnapshots is list &&
      request.resource.data.participantSnapshots.size() == 2 &&
      request.resource.data.sourceServiceIds is list &&
      request.resource.data.sourceServiceIds.size() == 0 &&
      request.resource.data.lastServiceId == '' &&
      request.resource.data.lastServiceTitle == '' &&
      request.resource.data.lastServiceImageUrl == '' &&
      request.resource.data.lastMessage == '' &&
      request.resource.data.lastSenderId == '' &&
      request.resource.data.unreadCountCustomer == 0 &&
      request.resource.data.unreadCountProvider == 0 &&
      request.resource.data.customerLastReadAt == null &&
      request.resource.data.providerLastReadAt == null &&
      request.resource.data.status == 'active' &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time;
    }

    function safeProviderServiceChatCreate(chatId) {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'chatType',
        'customerId',
        'providerId',
        'participantIds',
        'participantSnapshots',
        'customerName',
        'customerPhotoUrl',
        'providerName',
        'providerPhotoUrl',
        'sourceServiceIds',
        'lastServiceId',
        'lastServiceTitle',
        'lastServiceImageUrl',
        'lastMessage',
        'lastMessageAt',
        'lastSenderId',
        'unreadCountCustomer',
        'unreadCountProvider',
        'customerLastReadAt',
        'providerLastReadAt',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.chatType == 'providerService' &&
      directUserChatParticipantIdsValid() &&
      request.resource.data.customerId == request.auth.uid &&
      request.resource.data.customerId == request.resource.data.participantIds[0] &&
      request.resource.data.providerId == request.resource.data.participantIds[1] &&
      request.resource.data.customerId != request.resource.data.providerId &&
      (
        chatId == (request.resource.data.customerId + '_' + request.resource.data.providerId) ||
        chatId == (request.resource.data.providerId + '_' + request.resource.data.customerId)
      ) &&
      request.resource.data.participantSnapshots is list &&
      request.resource.data.participantSnapshots.size() == 2 &&
      request.resource.data.sourceServiceIds is list &&
      request.resource.data.sourceServiceIds.size() == 1 &&
      request.resource.data.lastServiceId is string &&
      request.resource.data.lastServiceId == request.resource.data.sourceServiceIds[0] &&
      request.resource.data.lastServiceTitle is string &&
      request.resource.data.lastServiceImageUrl is string &&
      request.resource.data.lastMessage == '' &&
      request.resource.data.lastSenderId == '' &&
      request.resource.data.unreadCountCustomer == 0 &&
      request.resource.data.unreadCountProvider == 0 &&
      request.resource.data.customerLastReadAt == null &&
      request.resource.data.providerLastReadAt == null &&
      request.resource.data.status == 'active' &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time &&
      exists(/databases/$(database)/documents/services/$(request.resource.data.lastServiceId)) &&
      get(/databases/$(database)/documents/services/$(request.resource.data.lastServiceId)).data.ownerUserId == request.resource.data.providerId &&
      get(/databases/$(database)/documents/services/$(request.resource.data.lastServiceId)).data.isDeleted != true &&
      get(/databases/$(database)/documents/services/$(request.resource.data.lastServiceId)).data.isVisibleToMarketplace == true;
    }

    function safeUserOwnerCreate() {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'uid',
        'role',
        'displayName',
        'name',
        'username',
        'usernameLowercase',
        'photoUrl',
        'state',
        'city',
        'profileImage',
        'bio',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.displayName is string &&
      request.resource.data.name == request.resource.data.displayName &&
      request.resource.data.photoUrl is string &&
      request.resource.data.profileImage == request.resource.data.photoUrl &&
      usernameFieldsConsistent(request.resource.data) &&
      usernameReservationMatchesUser(
        request.auth.uid,
        request.resource.data.usernameLowercase
      ) &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time;
    }

    function safeUserOwnerProfileBootstrapUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'role',
        'displayName',
        'name',
        'username',
        'usernameLowercase',
        'photoUrl',
        'state',
        'city',
        'profileImage',
        'bio',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid == resource.data.uid &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.displayName is string &&
      request.resource.data.name == request.resource.data.displayName &&
      request.resource.data.photoUrl is string &&
      request.resource.data.profileImage == request.resource.data.photoUrl &&
      usernameFieldsConsistent(request.resource.data) &&
      usernameReservationMatchesUser(
        request.auth.uid,
        request.resource.data.usernameLowercase
      ) &&
      (
        !resource.data.keys().hasAny(['createdAt']) ||
        request.resource.data.createdAt == resource.data.createdAt ||
        request.resource.data.createdAt == request.time
      ) &&
      (
        !resource.data.keys().hasAny(['usernameLowercase']) ||
        resource.data.usernameLowercase == '' ||
        request.resource.data.usernameLowercase == resource.data.usernameLowercase
      ) &&
      (
        !resource.data.keys().hasAny(['role']) ||
        resource.data.role == '' ||
        request.resource.data.role == resource.data.role
      ) &&
      request.resource.data.updatedAt == request.time;
    }

    function safeServiceOwnerUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'title',
        'titleLowercase',
        'animalType',
        'animalTypeLowercase',
        'category',
        'categoryLowercase',
        'description',
        'privateNotes',
        'pricePerSession',
        'schedulingMode',
        'sessionDurationMinutes',
        'capacity',
        'availableDays',
        'startMinutes',
        'endMinutes',
        'sameForAllDays',
        'serviceRadiusKm',
        'serviceType',
        'location',
        'photoUrls',
        'primaryPhotoUrl',
        'status',
        'isActive',
        'isDeleted',
        'isPaused',
        'isVisibleToMarketplace',
        'updatedAt',
        'removedAt'
      ]);
    }

    function safeServiceOwnerCreate() {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'ownerUserId',
        'ownerName',
        'ownerUsername',
        'ownerPhotoUrl',
        'ownerSnapshot',
        'title',
        'titleLowercase',
        'animalType',
        'animalTypeLowercase',
        'category',
        'categoryLowercase',
        'description',
        'privateNotes',
        'pricePerSession',
        'currency',
        'schedulingMode',
        'sessionDurationMinutes',
        'capacity',
        'availableDays',
        'startMinutes',
        'endMinutes',
        'sameForAllDays',
        'serviceType',
        'location',
        'photoUrls',
        'primaryPhotoUrl',
        'status',
        'isActive',
        'isDeleted',
        'isPaused',
        'moderationStatus',
        'isVisibleToMarketplace',
        'providerVerificationStatus',
        'providerVerificationGraceEndsAt',
        'isPausedByVerification',
        'pauseReason',
        'createdAt',
        'updatedAt',
        'publishedAt'
      ]) &&
      request.resource.data.providerVerificationStatus in [
        'pending',
        'approved',
        'rejected',
        'notSubmitted'
      ] &&
      (
        !request.resource.data.keys().hasAny(['providerVerificationGraceEndsAt']) ||
        request.resource.data.providerVerificationGraceEndsAt == null ||
        request.resource.data.providerVerificationGraceEndsAt is timestamp
      ) &&
      request.resource.data.isPausedByVerification == false &&
      request.resource.data.pauseReason is string &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.publishedAt == request.time;
    }

    function providerVerificationDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/providerVerification/main);
    }

    function providerBankDetailsDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/providerBankDetails/main);
    }

    function safeServiceVerificationCreate(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/providerVerification/main) &&
        (
          providerVerificationDoc(userId).data.status == 'approved' ||
          (
            providerVerificationDoc(userId).data.status == 'pending' &&
            (
              (
                providerVerificationDoc(userId).data.gracePeriodEndsAt == null &&
                providerVerificationDoc(userId).data.firstServiceListedAt == null
              ) ||
              (
                providerVerificationDoc(userId).data.gracePeriodEndsAt is timestamp &&
                providerVerificationDoc(userId).data.gracePeriodEndsAt > request.time
              )
            )
          )
        );
    }

    function safeUserOwnerUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'name',
        'bio',
        'role',
        'profileType',
        'photoUrl',
        'profileImage',
        'city',
        'state',
        'country',
        'location',
        'address',
        'updatedAt'
      ]) &&
      request.resource.data.uid == resource.data.uid &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.createdAt == resource.data.createdAt &&
      request.resource.data.username == resource.data.username &&
      request.resource.data.usernameLowercase == resource.data.usernameLowercase &&
      request.resource.data.displayName is string &&
      request.resource.data.name == request.resource.data.displayName &&
      request.resource.data.role in ['petParent', 'serviceProvider', 'petLover'] &&
      request.resource.data.photoUrl is string &&
      request.resource.data.profileImage == request.resource.data.photoUrl &&
      request.resource.data.updatedAt == request.time;
    }

    function safeUserPrivateOwnerWrite(userId) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'phoneNumber',
        'phone',
        'mobileNumber',
        'emailVerified',
        'phoneVerified',
        'providers',
        'accountStatus',
        'scheduledDeletionAt',
        'acceptedTermsAt',
        'acceptedPrivacyAt',
        'acceptedProviderAgreementAt',
        'exploreLocation',
        'createdAt',
        'updatedAt',
        'deletionRequestedAt',
        'deletionRequestStatus'
      ]) &&
      request.resource.data.uid == userId &&
      (
        !request.resource.data.keys().hasAny(['acceptedTermsAt']) ||
        request.resource.data.acceptedTermsAt is timestamp
      ) &&
      (
        !request.resource.data.keys().hasAny(['acceptedPrivacyAt']) ||
        request.resource.data.acceptedPrivacyAt is timestamp
      ) &&
      (
        !request.resource.data.keys().hasAny(['acceptedProviderAgreementAt']) ||
        request.resource.data.acceptedProviderAgreementAt is timestamp
      ) &&
      (
        !request.resource.data.keys().hasAny(['email']) ||
        request.resource.data.email is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['phoneNumber']) ||
        request.resource.data.phoneNumber is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['phone']) ||
        request.resource.data.phone is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['mobileNumber']) ||
        request.resource.data.mobileNumber is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['emailVerified']) ||
        request.resource.data.emailVerified is bool
      ) &&
      (
        !request.resource.data.keys().hasAny(['phoneVerified']) ||
        request.resource.data.phoneVerified is bool
      ) &&
      (
        !request.resource.data.keys().hasAny(['providers']) ||
        request.resource.data.providers is list
      ) &&
      (
        !request.resource.data.keys().hasAny(['accountStatus']) ||
        request.resource.data.accountStatus is string
      ) &&
      (
        !request.resource.data.keys().hasAny(['exploreLocation']) ||
        request.resource.data.exploreLocation == null ||
        (
          request.resource.data.exploreLocation is map &&
          request.resource.data.exploreLocation.keys().hasOnly([
            'latitude',
            'longitude',
            'city',
            'state',
            'country',
            'geohash3',
            'geohash4',
            'geohash5',
            'updatedAt'
          ]) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['latitude']) ||
            request.resource.data.exploreLocation.latitude is number
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['longitude']) ||
            request.resource.data.exploreLocation.longitude is number
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['city']) ||
            request.resource.data.exploreLocation.city is string
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['state']) ||
            request.resource.data.exploreLocation.state is string
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['country']) ||
            request.resource.data.exploreLocation.country is string
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['geohash3']) ||
            request.resource.data.exploreLocation.geohash3 is string
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['geohash4']) ||
            request.resource.data.exploreLocation.geohash4 is string
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['geohash5']) ||
            request.resource.data.exploreLocation.geohash5 is string
          ) &&
          (
            !request.resource.data.exploreLocation.keys().hasAny(['updatedAt']) ||
            request.resource.data.exploreLocation.updatedAt == request.time
          )
        )
      ) &&
      (
        !request.resource.data.keys().hasAny(['scheduledDeletionAt']) ||
        request.resource.data.scheduledDeletionAt == null ||
        request.resource.data.scheduledDeletionAt is timestamp
      ) &&
      (
        !request.resource.data.keys().hasAny(['deletionRequestedAt']) ||
        request.resource.data.deletionRequestedAt == null
      ) &&
      (
        !request.resource.data.keys().hasAny(['deletionRequestStatus']) ||
        request.resource.data.deletionRequestStatus == null
      ) &&
      request.resource.data.updatedAt == request.time;
    }

    function safeUserPrivateOwnerCreate(userId) {
      return safeUserPrivateOwnerWrite(userId) &&
        request.resource.data.createdAt == request.time;
    }

    function safeUserPrivateOwnerUpdate(userId) {
      return safeUserPrivateOwnerWrite(userId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'acceptedTermsAt',
          'acceptedPrivacyAt',
          'acceptedProviderAgreementAt',
          'exploreLocation',
          'updatedAt'
        ]) &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function safeSocialPostCreate() {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'id',
        'authorId',
        'authorType',
        'authorDisplayName',
        'authorUsername',
        'authorPhotoUrl',
        'authorCategoryLabel',
        'authorCity',
        'authorState',
        'isAdminPost',
        'adminPriorityBoost',
        'recentEngagementScore',
        'imageUrls',
        'thumbnailUrls',
        'imageAspectRatio',
        'caption',
        'hashtags',
        'likeCount',
        'commentCount',
        'shareCount',
        'saveCount',
        'reportCount',
        'visibilityStatus',
        'moderationStatus',
        'moderationReason',
        'moderatedBy',
        'moderatedAt',
        'lastReportedAt',
        'homeScore',
        'homeRankVersion',
        'homeScoreUpdatedAt',
        'homeEligible',
        'discoverScore',
        'discoverRankVersion',
        'discoverScoreUpdatedAt',
        'discoverEligible',
        'nearbyEligible',
        'feedGeohash3',
        'feedGeohash4',
        'feedGeohash5',
        'feedLocationVersion',
        'feedLocationUpdatedAt',
        'feedCityKey',
        'feedStateKey',
        'createdAtEpoch',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.id == request.resource.id &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.authorType == 'user' &&
      (
        !request.resource.data.keys().hasAny(['isAdminPost']) ||
        request.resource.data.isAdminPost == false
      ) &&
      (
        !request.resource.data.keys().hasAny(['adminPriorityBoost']) ||
        request.resource.data.adminPriorityBoost == 0
      ) &&
      (
        !request.resource.data.keys().hasAny(['recentEngagementScore']) ||
        request.resource.data.recentEngagementScore == 0
      ) &&
      request.resource.data.imageUrls.size() > 0 &&
      request.resource.data.imageUrls.size() <= 5 &&
      request.resource.data.thumbnailUrls.size() == request.resource.data.imageUrls.size() &&
      request.resource.data.imageAspectRatio in ['square', 'portrait', 'landscape'] &&
      request.resource.data.likeCount == 0 &&
      request.resource.data.commentCount == 0 &&
      request.resource.data.shareCount == 0 &&
      (
        !request.resource.data.keys().hasAny(['saveCount']) ||
        request.resource.data.saveCount == 0
      ) &&
      request.resource.data.reportCount == 0 &&
      request.resource.data.visibilityStatus == 'visible' &&
      request.resource.data.moderationStatus == 'approved' &&
      (
        !request.resource.data.keys().hasAny(['moderationReason']) ||
        request.resource.data.moderationReason == ''
      ) &&
      (
        !request.resource.data.keys().hasAny(['moderatedBy']) ||
        request.resource.data.moderatedBy == ''
      ) &&
      (
        !request.resource.data.keys().hasAny(['moderatedAt']) ||
        request.resource.data.moderatedAt == null
      ) &&
      (
        !request.resource.data.keys().hasAny(['lastReportedAt']) ||
        request.resource.data.lastReportedAt == null
      ) &&
      (
        !request.resource.data.keys().hasAny(['homeScore']) ||
        request.resource.data.homeScore == 0
      ) &&
      (
        !request.resource.data.keys().hasAny(['homeRankVersion']) ||
        request.resource.data.homeRankVersion == 0
      ) &&
      (
        !request.resource.data.keys().hasAny(['homeScoreUpdatedAt']) ||
        request.resource.data.homeScoreUpdatedAt == null
      ) &&
      (
        !request.resource.data.keys().hasAny(['homeEligible']) ||
        request.resource.data.homeEligible == false
      ) &&
      (
        !request.resource.data.keys().hasAny(['discoverScore']) ||
        request.resource.data.discoverScore == 0
      ) &&
      (
        !request.resource.data.keys().hasAny(['discoverRankVersion']) ||
        request.resource.data.discoverRankVersion == 0
      ) &&
      (
        !request.resource.data.keys().hasAny(['discoverScoreUpdatedAt']) ||
        request.resource.data.discoverScoreUpdatedAt == null
      ) &&
      (
        !request.resource.data.keys().hasAny(['discoverEligible']) ||
        request.resource.data.discoverEligible == false
      ) &&
      (
        !request.resource.data.keys().hasAny(['nearbyEligible']) ||
        request.resource.data.nearbyEligible == false
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedGeohash3']) ||
        request.resource.data.feedGeohash3 == ''
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedGeohash4']) ||
        request.resource.data.feedGeohash4 == ''
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedGeohash5']) ||
        request.resource.data.feedGeohash5 == ''
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedLocationVersion']) ||
        request.resource.data.feedLocationVersion == 0
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedLocationUpdatedAt']) ||
        request.resource.data.feedLocationUpdatedAt == null
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedCityKey']) ||
        request.resource.data.feedCityKey == ''
      ) &&
      (
        !request.resource.data.keys().hasAny(['feedStateKey']) ||
        request.resource.data.feedStateKey == ''
      ) &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time;
    }

    function likeDocPath(postId) {
      return /databases/$(database)/documents/socialPosts/$(postId)/likes/$(request.auth.uid);
    }

    function reportDocPath(postId) {
      return /databases/$(database)/documents/socialPosts/$(postId)/reports/$(request.auth.uid);
    }

    function safeSocialPostCommentCounterUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'commentCount'
      ]) &&
      resource.data.visibilityStatus == 'visible' &&
      resource.data.moderationStatus == 'approved' &&
      request.resource.data.commentCount >= 0 &&
      (
        request.resource.data.commentCount == resource.data.commentCount + 1 ||
        request.resource.data.commentCount == resource.data.commentCount - 1
      );
    }

    function safeSocialPostShareCounterUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'shareCount'
      ]) &&
      resource.data.visibilityStatus == 'visible' &&
      resource.data.moderationStatus == 'approved' &&
      request.resource.data.shareCount == resource.data.shareCount + 1;
    }

    function safeSocialPostAuthorSnapshotUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'authorDisplayName',
        'authorPhotoUrl',
        'authorCategoryLabel',
        'authorCity',
        'authorState',
        'updatedAt'
      ]) &&
      resource.data.authorId == request.auth.uid &&
      resource.data.authorType == 'user' &&
      request.resource.data.authorDisplayName is string &&
      request.resource.data.authorDisplayName.size() > 0 &&
      request.resource.data.authorPhotoUrl is string &&
      request.resource.data.authorCategoryLabel is string &&
      request.resource.data.authorCategoryLabel.size() > 0 &&
      request.resource.data.authorCity is string &&
      request.resource.data.authorState is string &&
      request.resource.data.updatedAt == request.time;
    }

    function safeSocialPostSoftDelete() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'visibilityStatus',
        'updatedAt'
      ]) &&
      resource.data.authorId == request.auth.uid &&
      request.resource.data.visibilityStatus == 'deleted' &&
      request.resource.data.updatedAt == request.time;
    }

    function safeSocialPostLikeCounterUpdate(postId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'likeCount'
      ]) &&
      resource.data.visibilityStatus == 'visible' &&
      resource.data.moderationStatus == 'approved' &&
      request.resource.data.likeCount >= 0 &&
      (
        (
          request.resource.data.likeCount == resource.data.likeCount + 1 &&
          !exists(likeDocPath(postId)) &&
          existsAfter(likeDocPath(postId))
        ) ||
        (
          request.resource.data.likeCount == resource.data.likeCount - 1 &&
          exists(likeDocPath(postId)) &&
          !existsAfter(likeDocPath(postId))
        )
      );
    }

    function safeSocialPostReportCounterUpdate(postId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'reportCount',
        'moderationStatus',
        'lastReportedAt'
      ]) &&
      resource.data.visibilityStatus == 'visible' &&
      resource.data.moderationStatus == 'approved' &&
      request.resource.data.reportCount == resource.data.reportCount + 1 &&
      request.resource.data.lastReportedAt == request.time &&
      (
        (
          request.resource.data.reportCount >= 5 &&
          request.resource.data.moderationStatus == 'pending'
        ) ||
        (
          request.resource.data.reportCount < 5 &&
          request.resource.data.moderationStatus == resource.data.moderationStatus
        )
      ) &&
      !exists(reportDocPath(postId)) &&
      existsAfter(reportDocPath(postId));
    }

    function safeCommentCreate(postId, commentId) {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'id',
        'postId',
        'authorId',
        'authorDisplayName',
        'authorUsername',
        'authorPhotoUrl',
        'parentPostAuthorId',
        'parentPostPreview',
        'text',
        'likeCount',
        'reportCount',
        'visibilityStatus',
        'moderationStatus',
        'moderationReason',
        'moderatedBy',
        'moderatedAt',
        'lastReportedAt',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.id == commentId &&
      request.resource.data.postId == postId &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.likeCount == 0 &&
      request.resource.data.reportCount == 0 &&
      request.resource.data.visibilityStatus == 'visible' &&
      request.resource.data.moderationStatus == 'approved' &&
      request.resource.data.moderationReason == '' &&
      request.resource.data.moderatedBy == '' &&
      request.resource.data.moderatedAt == null &&
      request.resource.data.lastReportedAt == null &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time;
    }

    function safeCommentSoftDelete() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'visibilityStatus',
        'updatedAt'
      ]) &&
      resource.data.authorId == request.auth.uid &&
      request.resource.data.visibilityStatus == 'deleted' &&
      request.resource.data.updatedAt == request.time;
    }

    function safeCommentReportCounterUpdate(postId, commentId) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'reportCount',
        'moderationStatus',
        'lastReportedAt'
      ]) &&
      resource.data.visibilityStatus == 'visible' &&
      resource.data.moderationStatus == 'approved' &&
      request.resource.data.reportCount == resource.data.reportCount + 1 &&
      request.resource.data.lastReportedAt == request.time &&
      (
        (
          request.resource.data.reportCount >= 5 &&
          request.resource.data.moderationStatus == 'pending'
        ) ||
        (
          request.resource.data.reportCount < 5 &&
          request.resource.data.moderationStatus == resource.data.moderationStatus
        )
      ) &&
      !exists(/databases/$(database)/documents/socialPosts/$(postId)/comments/$(commentId)/reports/$(request.auth.uid)) &&
      existsAfter(/databases/$(database)/documents/socialPosts/$(postId)/comments/$(commentId)/reports/$(request.auth.uid));
    }

    function safeHashtagCreate(tag) {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'tag',
        'postCount',
        'recentPostIds',
        'lastUsedAt'
      ]) &&
      tag.matches('^[a-z0-9_]{1,30}$') &&
      request.resource.data.tag == tag &&
      request.resource.data.postCount == 1 &&
      request.resource.data.recentPostIds is list &&
      request.resource.data.recentPostIds.size() >= 1 &&
      request.resource.data.recentPostIds.size() <= 30 &&
      request.resource.data.lastUsedAt == request.time;
    }

    // TODO(nishant): Move hashtag mutation to Cloud Functions for stronger
    // append-only guarantees and duplicate prevention at scale.
    function safeHashtagUpdate(tag) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'tag',
        'postCount',
        'recentPostIds',
        'lastUsedAt'
      ]) &&
      tag.matches('^[a-z0-9_]{1,30}$') &&
      resource.data.tag == tag &&
      request.resource.data.tag == tag &&
      request.resource.data.postCount >= 1 &&
      request.resource.data.postCount == resource.data.postCount + 1 &&
      request.resource.data.recentPostIds is list &&
      request.resource.data.recentPostIds.size() >= 1 &&
      request.resource.data.recentPostIds.size() <= 30 &&
      request.resource.data.lastUsedAt == request.time;
    }

    function safeNotificationTokenCreate() {
      return request.resource.data.diff({}).changedKeys().hasOnly([
        'token',
        'createdAt',
        'updatedAt',
        'lastSeenAt',
        'platform'
      ]) &&
      request.resource.data.token is string &&
      request.resource.data.token.size() > 0 &&
      request.resource.data.platform is string &&
      request.resource.data.platform.size() > 0 &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.lastSeenAt == request.time;
    }

    function safeNotificationTokenUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'token',
        'updatedAt',
        'lastSeenAt',
        'platform'
      ]) &&
      request.resource.data.token is string &&
      request.resource.data.token.size() > 0 &&
      request.resource.data.platform is string &&
      request.resource.data.platform.size() > 0 &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.lastSeenAt == request.time &&
      request.resource.data.createdAt == resource.data.createdAt;
    }

    function validProviderVerificationDocKeys(data) {
      return data.keys().hasOnly([
        'userId',
        'status',
        'documentType',
        'documentFrontPath',
        'documentBackPath',
        'documentFrontUrl',
        'documentBackUrl',
        'documentFrontContentType',
        'documentBackContentType',
        'documentFrontFileName',
        'documentBackFileName',
        'verificationMethod',
        'submittedAt',
        'reviewedAt',
        'documentDeletionScheduledAt',
        'documentDeletedAt',
        'reviewedBy',
        'rejectionReason',
        'firstServiceListedAt',
        'gracePeriodEndsAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validProviderVerificationPath(userId, path) {
      return path is string &&
        path.size() > 0 &&
        path.size() <= 512 &&
        path.matches('^providerVerification/' + userId + '/identity/[^/]+$');
    }

    function validOptionalProviderVerificationPath(userId, path) {
      return path == '' || validProviderVerificationPath(userId, path);
    }

    function safeProviderVerificationOwnerWrite(userId) {
      return validProviderVerificationDocKeys(request.resource.data) &&
        request.resource.data.userId == userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.documentType in ['aadhaar', 'panCard', 'drivingLicense', 'voterId'] &&
        validProviderVerificationPath(userId, request.resource.data.documentFrontPath) &&
        validOptionalProviderVerificationPath(userId, request.resource.data.documentBackPath) &&
        request.resource.data.documentFrontUrl is string &&
        request.resource.data.documentFrontUrl == '' &&
        request.resource.data.documentBackUrl is string &&
        (
          request.resource.data.documentBackUrl == '' ||
          request.resource.data.documentBackUrl == null
        ) &&
        (
          !request.resource.data.keys().hasAny(['documentFrontContentType']) ||
          (
            request.resource.data.documentFrontContentType is string &&
            request.resource.data.documentFrontContentType.size() <= 100
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['documentBackContentType']) ||
          request.resource.data.documentBackContentType == null ||
          (
            request.resource.data.documentBackContentType is string &&
            request.resource.data.documentBackContentType.size() <= 100
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['documentFrontFileName']) ||
          (
            request.resource.data.documentFrontFileName is string &&
            request.resource.data.documentFrontFileName.size() <= 255
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['documentBackFileName']) ||
          request.resource.data.documentBackFileName == null ||
          (
            request.resource.data.documentBackFileName is string &&
            request.resource.data.documentBackFileName.size() <= 255
          )
        ) &&
        (
          request.resource.data.documentType != 'panCard' ||
          request.resource.data.documentBackPath == '' &&
          (
            request.resource.data.documentBackContentType == null ||
            request.resource.data.documentBackContentType == ''
          ) &&
          (
            request.resource.data.documentBackFileName == null ||
            request.resource.data.documentBackFileName == ''
          )
        ) &&
        request.resource.data.verificationMethod == 'manual' &&
        request.resource.data.reviewedAt == null &&
        request.resource.data.reviewedBy == null &&
        (
          request.resource.data.rejectionReason == null ||
          request.resource.data.rejectionReason == ''
        ) &&
        request.resource.data.documentDeletionScheduledAt == null &&
        request.resource.data.documentDeletedAt == null &&
        (
          !request.resource.data.keys().hasAny(['firstServiceListedAt']) ||
          request.resource.data.firstServiceListedAt == null ||
          request.resource.data.firstServiceListedAt is timestamp
        ) &&
        (
          !request.resource.data.keys().hasAny(['gracePeriodEndsAt']) ||
          request.resource.data.gracePeriodEndsAt == null ||
          request.resource.data.gracePeriodEndsAt is timestamp
        ) &&
        request.resource.data.updatedAt == request.time;
    }

    function safeProviderVerificationOwnerCreate(userId) {
      return safeProviderVerificationOwnerWrite(userId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.submittedAt == request.time;
    }

    function safeProviderVerificationOwnerUpdate(userId) {
      return (
        safeProviderVerificationOwnerWrite(userId) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.submittedAt == request.time &&
        resource.data.status != 'approved'
      ) || (
        validProviderVerificationDocKeys(request.resource.data) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.documentType == resource.data.documentType &&
        request.resource.data.documentFrontPath == resource.data.documentFrontPath &&
        request.resource.data.documentBackPath == resource.data.documentBackPath &&
        request.resource.data.documentFrontUrl == resource.data.documentFrontUrl &&
        request.resource.data.documentBackUrl == resource.data.documentBackUrl &&
        request.resource.data.documentFrontContentType == resource.data.documentFrontContentType &&
        request.resource.data.documentBackContentType == resource.data.documentBackContentType &&
        request.resource.data.documentFrontFileName == resource.data.documentFrontFileName &&
        request.resource.data.documentBackFileName == resource.data.documentBackFileName &&
        request.resource.data.verificationMethod == resource.data.verificationMethod &&
        request.resource.data.submittedAt == resource.data.submittedAt &&
        request.resource.data.reviewedAt == resource.data.reviewedAt &&
        request.resource.data.documentDeletionScheduledAt == resource.data.documentDeletionScheduledAt &&
        request.resource.data.documentDeletedAt == resource.data.documentDeletedAt &&
        request.resource.data.reviewedBy == resource.data.reviewedBy &&
        request.resource.data.rejectionReason == resource.data.rejectionReason &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'firstServiceListedAt',
          'gracePeriodEndsAt',
          'updatedAt'
        ]) &&
        request.resource.data.firstServiceListedAt is timestamp &&
        request.resource.data.gracePeriodEndsAt is timestamp &&
        request.resource.data.gracePeriodEndsAt > request.time &&
        resource.data.status == 'pending' &&
        resource.data.reviewedAt == null &&
        resource.data.reviewedBy == null
      );
    }

    function safeProviderBankDetailsOwnerWrite(userId) {
      return request.resource.data.keys().hasOnly([
        'userId',
        'accountHolderName',
        'bankName',
        'accountNumberMasked',
        'ifscCode',
        'upiId',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.userId == userId &&
      request.resource.data.accountHolderName is string &&
      request.resource.data.accountHolderName.size() > 0 &&
      request.resource.data.bankName is string &&
      request.resource.data.bankName.size() > 0 &&
      request.resource.data.accountNumberMasked is string &&
      request.resource.data.accountNumberMasked.size() >= 4 &&
      request.resource.data.ifscCode is string &&
      request.resource.data.ifscCode.matches('^[A-Z]{4}0[A-Z0-9]{6}$') &&
      request.resource.data.upiId is string &&
      request.resource.data.status == 'submitted' &&
      request.resource.data.updatedAt == request.time;
    }

    function safeAdminSocialModerationUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'moderationStatus',
        'visibilityStatus',
        'moderationReason',
        'moderatedBy',
        'moderatedAt',
        'updatedAt'
      ]) &&
      request.resource.data.moderationStatus in ['approved', 'pending', 'rejected'] &&
      request.resource.data.visibilityStatus in ['visible', 'hidden', 'deleted'] &&
      request.resource.data.moderatedBy == request.auth.uid &&
      request.resource.data.moderatedAt == request.time &&
      request.resource.data.updatedAt == request.time;
    }

    function safePetKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'ownerId',
        'name',
        'animalType',
        'sex',
        'breed',
        'dateOfBirth',
        'weightKg',
        'photoUrl',
        'bio',
        'isVaccinated',
        'vaccinationDate',
        'isDewormed',
        'dewormingDate',
        'knownAllergies',
        'regularVet',
        'createdAt',
        'updatedAt',
        'isDeleted',
        'deletedAt'
      ]);
    }

    function safePetCreate(userId, petId) {
      return safePetKeys() &&
        request.resource.data.id == petId &&
        request.resource.data.ownerId == userId &&
        request.resource.data.name is string &&
        request.resource.data.animalType is string &&
        request.resource.data.sex is string &&
        request.resource.data.isDeleted == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function safePetUpdate(userId) {
      return safePetKeys() &&
        resource.data.ownerId == userId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.updatedAt == request.time;
    }

    function safeUsernameReservationWrite(normalizedUsername) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'username',
        'usernameLowercase',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.username == normalizedUsername &&
      request.resource.data.usernameLowercase == normalizedUsername &&
      validNormalizedUsername(normalizedUsername) &&
      request.resource.data.updatedAt == request.time;
    }

    match /usernames/{normalizedUsername} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        safeUsernameReservationWrite(normalizedUsername) &&
        request.resource.data.createdAt == request.time;
      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        safeUsernameReservationWrite(normalizedUsername) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        (
          !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLowercase != normalizedUsername
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) &&
        requesterAccountMissingOrActive() &&
        request.resource.data.uid == userId &&
        safeUserOwnerCreate();
      allow update: if isOwner(userId) &&
        requesterAccountMissingOrActive() &&
        (
          safeUserOwnerUpdate() ||
          safeUserOwnerProfileBootstrapUpdate()
        );
      allow delete: if false;

      match /claimedOffers/{claimedOfferId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /pets/{petId} {
        allow read: if signedIn() &&
          (resource.data.isDeleted != true || isOwner(userId) || isAdmin());
        allow create: if isOwner(userId) &&
          requesterAccountIsActive() &&
          safePetCreate(userId, petId);
        allow update: if isOwner(userId) &&
          requesterAccountIsActive() &&
          safePetUpdate(userId);
        allow delete: if false;
      }

      match /notificationTokens/{tokenId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          requesterAccountIsActive() &&
          safeNotificationTokenCreate();
        allow update: if isOwner(userId) &&
          requesterAccountIsActive() &&
          safeNotificationTokenUpdate();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /providerVerification/{docId} {
        // Owners may read only their own verification document. Support/admin
        // review is handled separately and does not grant public access.
        allow read: if isOwner(userId) || canReviewProviderVerification();
        allow create: if docId == 'main' &&
          isOwner(userId) &&
          requesterAccountIsActive() &&
          safeProviderVerificationOwnerCreate(userId);
        allow update: if docId == 'main' &&
          (
            (
              isOwner(userId) &&
              requesterAccountIsActive() &&
              safeProviderVerificationOwnerUpdate(userId)
            ) ||
            canReviewProviderVerification()
          );
        allow delete: if false;
      }

      match /providerBankDetails/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if docId == 'main' &&
          isOwner(userId) &&
          requesterAccountIsActive() &&
          safeProviderBankDetailsOwnerWrite(userId) &&
          request.resource.data.createdAt == request.time;
        allow update: if docId == 'main' &&
          isOwner(userId) &&
          requesterAccountIsActive() &&
          safeProviderBankDetailsOwnerWrite(userId) &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /adminNotes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // Collection group queries on providerVerification need an explicit
    // recursive matcher so Firestore can prove every matched document is
    // readable for the reviewing admin roles. This does not grant owners
    // access to other users' records, and client deletes remain blocked.
    match /{path=**}/providerVerification/{docId} {
      allow read: if canReviewProviderVerification();
      allow create, update, delete: if false;
    }

    match /verificationDocumentCleanup/{cleanupId} {
      allow read, write: if false;
    }

    match /userPrivate/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        requesterAccountMissingOrActive() &&
        safeUserPrivateOwnerCreate(userId);
      allow update: if isOwner(userId) &&
        requesterAccountMissingOrActive() &&
        safeUserPrivateOwnerUpdate(userId);
      allow delete: if false;

      // User-facing Play review state is private per UID and user-to-user
      // sharing is not a product feature.
      match /playStoreReview/{docId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          requesterAccountMissingOrActive() &&
          docId == 'state' &&
          request.resource.data.uid == userId &&
          request.resource.data.diff({}).changedKeys().hasOnly([
            'uid',
            'createdAt',
            'updatedAt',
            'appOpenCount',
            'successfulPostCount',
            'completedBookingMilestoneCount',
            'completedBookingMilestoneUnlocked',
            'secondSocialPostMilestoneUnlocked',
            'appOpenFallbackMilestoneUnlocked',
            'pendingOpportunity',
            'pendingOpportunitySource',
            'requestCount',
            'lastRequestedAt'
          ]) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId) &&
          requesterAccountMissingOrActive() &&
          docId == 'state' &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'updatedAt',
            'appOpenCount',
            'successfulPostCount',
            'completedBookingMilestoneCount',
            'completedBookingMilestoneUnlocked',
            'secondSocialPostMilestoneUnlocked',
            'appOpenFallbackMilestoneUnlocked',
            'pendingOpportunity',
            'pendingOpportunitySource',
            'requestCount',
            'lastRequestedAt'
          ]) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /playStoreReviewCompletedBookings/{bookingId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          requesterAccountMissingOrActive() &&
          request.resource.data.diff({}).changedKeys().hasOnly([
            'bookingId',
            'processedAt'
          ]) &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.processedAt == request.time;
        allow update, delete: if false;
      }

      // Offer Wall state is server-owned so app-launch counting and
      // impression limits remain authoritative per user and campaign.
      match /offerWallState/{campaignId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /offerWallLaunchSessions/{sessionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /offerCampaigns/{offerId} {
      allow read: if isAdmin() || (signedIn() && resource.data.isActive == true);
      allow create, update, delete: if false;
    }

    match /offerWallCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn() &&
        (
          resource.data.followerId == request.auth.uid ||
          resource.data.followeeId == request.auth.uid
        );
      allow create: if requesterAccountIsActive() &&
        request.resource.data.diff({}).changedKeys().hasOnly([
          'followerId',
          'followeeId',
          'createdAt'
        ]) &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followeeId is string &&
        request.resource.data.followeeId != request.auth.uid &&
        request.resource.id == (request.resource.data.followerId + '_' + request.resource.data.followeeId) &&
        request.resource.data.createdAt == request.time;
      allow delete: if requesterAccountIsActive() &&
        resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /userBlocks/{blockId} {
      allow get: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow list: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if requesterAccountIsActive() &&
        request.resource.data.diff({}).changedKeys().hasOnly([
          'ownerUserId',
          'blockedUserId',
          'createdAt'
        ]) &&
        request.resource.data.ownerUserId == request.auth.uid &&
        request.resource.data.blockedUserId is string &&
        request.resource.data.blockedUserId != request.auth.uid &&
        request.resource.id == (request.resource.data.ownerUserId + '_' + request.resource.data.blockedUserId) &&
        request.resource.data.createdAt == request.time;
      allow delete: if requesterAccountIsActive() &&
        resource.data.ownerUserId == request.auth.uid;
      allow update: if false;
    }

    match /userMutes/{muteId} {
      allow get: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow list: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if requesterAccountIsActive() &&
        request.resource.data.diff({}).changedKeys().hasOnly([
          'ownerUserId',
          'mutedUserId',
          'createdAt'
        ]) &&
        request.resource.data.ownerUserId == request.auth.uid &&
        request.resource.data.mutedUserId is string &&
        request.resource.data.mutedUserId != request.auth.uid &&
        request.resource.id == (request.resource.data.ownerUserId + '_' + request.resource.data.mutedUserId) &&
        request.resource.data.createdAt == request.time;
      allow delete: if requesterAccountIsActive() &&
        resource.data.ownerUserId == request.auth.uid;
      allow update: if false;
    }

    match /hashtags/{tag} {
      allow read: if signedIn();
      allow create: if requesterAccountIsActive() && safeHashtagCreate(tag);
      allow update: if requesterAccountIsActive() && safeHashtagUpdate(tag);
      allow delete: if false;
    }

    match /socialPosts/{postId} {
      allow read: if canModerateSocialContent() || isAdmin() || (
        signedIn() &&
        (
          (
            resource.data.visibilityStatus == 'visible' &&
            resource.data.moderationStatus == 'approved'
          ) ||
          resource.data.authorId == request.auth.uid
        )
      );
      allow create: if requesterAccountIsActive() && safeSocialPostCreate();
      allow update: if requesterAccountIsActive() &&
        (
          (canModerateSocialContent() && safeAdminSocialModerationUpdate()) ||
          safeSocialPostAuthorSnapshotUpdate() ||
          safeSocialPostSoftDelete() ||
          safeSocialPostLikeCounterUpdate(postId) ||
          safeSocialPostReportCounterUpdate(postId) ||
          safeSocialPostCommentCounterUpdate() ||
          safeSocialPostShareCounterUpdate()
        );
      allow delete: if false;

      match /likes/{userId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if requesterAccountIsActive() &&
          request.auth.uid == userId &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.visibilityStatus == 'visible' &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.moderationStatus == 'approved' &&
          request.resource.data.diff({}).changedKeys().hasOnly([
            'userId',
            'createdAt'
          ]) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow delete: if requesterAccountIsActive() &&
          request.auth.uid == userId &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.visibilityStatus == 'visible' &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.moderationStatus == 'approved';
        allow update: if false;
      }

      match /reports/{userId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
        allow create: if requesterAccountIsActive() &&
          request.auth.uid == userId &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.visibilityStatus == 'visible' &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.moderationStatus == 'approved' &&
          request.resource.data.diff({}).changedKeys().hasOnly([
            'reporterId',
            'reason',
            'createdAt'
          ]) &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if canModerateSocialContent() || isAdmin() || (
          signedIn() &&
          (
            (
              get(/databases/$(database)/documents/socialPosts/$(postId)).data.visibilityStatus == 'visible' &&
              get(/databases/$(database)/documents/socialPosts/$(postId)).data.moderationStatus == 'approved'
            ) ||
            resource.data.authorId == request.auth.uid
          )
        );
        allow create: if requesterAccountIsActive() &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.visibilityStatus == 'visible' &&
          get(/databases/$(database)/documents/socialPosts/$(postId)).data.moderationStatus == 'approved' &&
          safeCommentCreate(postId, commentId);
        allow update: if requesterAccountIsActive() &&
          (
            (canModerateSocialContent() && safeAdminSocialModerationUpdate()) ||
            safeCommentSoftDelete() ||
            safeCommentReportCounterUpdate(postId, commentId)
          );
        allow delete: if false;

        match /reports/{userId} {
          allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
          allow create: if requesterAccountIsActive() &&
            request.auth.uid == userId &&
            get(/databases/$(database)/documents/socialPosts/$(postId)/comments/$(commentId)).data.visibilityStatus == 'visible' &&
            get(/databases/$(database)/documents/socialPosts/$(postId)/comments/$(commentId)).data.moderationStatus == 'approved' &&
            request.resource.data.diff({}).changedKeys().hasOnly([
              'reporterId',
              'reason',
              'createdAt'
            ]) &&
            request.resource.data.reporterId == request.auth.uid &&
            request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }
    }

    match /socialPostPrivate/{postId} {
      allow read, write: if false;
    }

    match /nearbyFeedSessions/{sessionId} {
      allow read, write: if false;
    }

    // Collection group queries for admin moderation need a path-agnostic
    // comments match. Keep this read-only and moderator-only so it does not
    // broaden normal user access.
    match /{path=**}/comments/{commentId} {
      allow read: if canModerateSocialContent();
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || (
        signedIn() &&
        (resource.data.isDeleted != true) &&
        (
          resource.data.isVisibleToMarketplace == true ||
          resource.data.ownerUserId == request.auth.uid
        )
      );

      allow create: if requesterAccountIsActive() &&
        request.resource.data.ownerUserId == request.auth.uid &&
        safeServiceVerificationCreate(request.auth.uid);

      allow update: if isAdmin() ||
        (
          requesterAccountIsActive() &&
          existingOwnerId() == request.auth.uid &&
          request.resource.data.ownerUserId == resource.data.ownerUserId &&
          request.resource.data.moderationStatus == resource.data.moderationStatus &&
          safeServiceOwnerUpdate()
        );

      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if requesterAccountIsActive() &&
          request.resource.data.reviewerId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /slots/{slotId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/services/$(serviceId)).data.isVisibleToMarketplace == true ||
            get(/databases/$(database)/documents/services/$(serviceId)).data.ownerUserId == request.auth.uid ||
            isAdmin()
          );

        // Slot creation, regeneration, acceptedCount, and capacity transitions
        // are server-owned so customers and providers cannot bypass capacity.
        allow create, update, delete: if isAdmin();
      }

      match /moderationEvents/{eventId} {
        allow read, write: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() &&
        (
          resource.data.customerId == request.auth.uid ||
          resource.data.serviceOwnerId == request.auth.uid ||
          isAdmin()
        );

      // Creation, status transitions, OTP verification, completion, and payout
      // changes are intentionally blocked for clients and handled by Cloud
      // Functions using the Admin SDK.
      allow create, update, delete: if isAdmin();

      match /events/{eventId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid ||
            isAdmin()
          );
        allow write: if isAdmin();
      }

      match /paymentAttempts/{paymentAttemptId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid ||
            isAdmin()
          );
        allow write: if false;
      }

      match /statusHistory/{historyId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid ||
            isAdmin()
          );
        allow write: if isAdmin();
      }

      match /messages/{messageId} {
        allow read, create: if signedIn() &&
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid ||
            isAdmin()
          );
        allow update, delete: if isAdmin();
      }
    }

    match /bookingPrivate/{bookingId} {
      allow read: if signedIn() &&
        (
          (
            exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
            (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.parentId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid
            ) &&
            (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'CONFIRMED' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'IN_PROGRESS' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'COMPLETED_PENDING_REVIEW' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'COMPLETED_FINAL'
            ) &&
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.lifecycle.paidAt != null
          ) ||
          isAdmin()
        );
      allow write: if false;
    }

    match /bookingPrivateParticipants/{bookingId} {
      allow read: if signedIn() &&
        (
          (
            exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
            (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.parentId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid
            ) &&
            (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'CONFIRMED' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'IN_PROGRESS' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'COMPLETED_PENDING_REVIEW' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'COMPLETED_FINAL'
            ) &&
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.lifecycle.paidAt != null
          ) ||
          isAdmin()
        );
      allow write: if false;
    }

    match /bookingChats/{bookingId} {
      allow read: if signedIn() &&
        (
          (
            request.auth.uid in resource.data.participantIds &&
            (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'CONFIRMED' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'IN_PROGRESS' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'COMPLETED_PENDING_REVIEW' ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.state == 'COMPLETED_FINAL'
            ) &&
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.lifecycle.paidAt != null
          ) ||
          isAdmin()
        );
      allow write: if false;
    }

    match /payoutReadiness/{bookingId} {
      allow read: if signedIn() &&
        (
          resource.data.providerId == request.auth.uid ||
          resource.data.customerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /bookingFinancials/{bookingId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /refunds/{refundId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /bookingCancellations/{bookingId} {
      allow read: if signedIn() &&
        (
          resource.data.actorId == request.auth.uid ||
          (
            exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
            (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.parentId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid
            )
          ) ||
          isAdmin()
        );
      allow write: if false;
    }

    match /bookingFinancialAdjustments/{bookingId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /capacityReleases/{bookingId} {
      allow read: if signedIn() &&
        (
          exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.parentId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.serviceOwnerId == request.auth.uid ||
            isAdmin()
          )
        );
      allow write: if false;
    }

    match /providerEarnings/{earningId} {
      allow read: if signedIn() &&
        (
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /services/{serviceId}/slotOccupancy/{slotId} {
      allow read, write: if false;
    }

    match /services/{serviceId}/occupancy/{dateKey} {
      allow read, write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() &&
        (
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /providerPayouts/{payoutId} {
      allow read: if signedIn() &&
        (
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow write: if false;
    }

    match /bookingFinancialLedger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bookingDisputeResolutions/{resolutionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bookingFinancialReconciliation/{bookingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin() ||
        (signedIn() &&
          (
            resource.data.reporterId == request.auth.uid ||
            resource.data.reportedBy == request.auth.uid
          )
        );
      allow create: if requesterAccountIsActive() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.reportedBy == request.auth.uid ||
          request.resource.data.reporterId == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /accountDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    match /disputes/{disputeId} {
      allow read: if signedIn() &&
        (
          resource.data.customerId == request.auth.uid ||
          resource.data.providerId == request.auth.uid ||
          isAdmin()
        );
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/disputes/$(disputeId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/disputes/$(disputeId)).data.providerId == request.auth.uid ||
            isAdmin()
          );
        allow create, update, delete: if false;
      }

      match /evidence/{evidenceId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/disputes/$(disputeId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/disputes/$(disputeId)).data.providerId == request.auth.uid ||
            isAdmin()
          );
        allow create, update, delete: if false;
      }
    }

    match /moderationQueue/{moderationItemId} {
      allow read, write: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if chatParticipant(resource.data) || canMonitorChats();
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          (
            chatParticipant(
              get(/databases/$(database)/documents/chats/$(chatId)).data
            ) ||
            canMonitorChats()
          );
        allow create, update, delete: if false;
      }
    }

    match /supportTickets/{ticketId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          canManageSupportTickets()
        );
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          (
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid ||
            canManageSupportTickets()
          );
        allow create, update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'read',
          'isRead',
          'updatedAt'
        ]) &&
        request.resource.data.read == true &&
        request.resource.data.isRead == true &&
        request.resource.data.updatedAt == request.time;
      allow create, delete: if isAdmin();
    }

    match /notificationBroadcasts/{broadcastId} {
      allow read, write: if false;
    }
  }
}
