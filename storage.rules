rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin", "financeAdmin"];
    }

    function canManageOfferWalls() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "financeAdmin"];
    }

    function canManageMarketingCampaigns() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole == "superAdmin";
    }

    function canReviewProviderVerificationDocuments() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin"];
    }

    function canManageSupportTickets() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin"];
    }

    function canMonitorChatMedia() {
      return signedIn() &&
        firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        ) &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.keys().hasAny(["adminRole"]) &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin"];
    }

    function chatForMedia(chatId) {
      return firestore.get(
        /databases/(default)/documents/chats/$(chatId)
      );
    }

    function isChatMediaParticipant(chatId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/chats/$(chatId)) &&
        chatForMedia(chatId).data.chatType == "directUser" &&
        chatForMedia(chatId).data.participantIds is list &&
        chatForMedia(chatId).data.participantIds.size() == 2 &&
        chatForMedia(chatId).data.participantIds[0] is string &&
        chatForMedia(chatId).data.participantIds[1] is string &&
        chatForMedia(chatId).data.participantIds[0] !=
          chatForMedia(chatId).data.participantIds[1] &&
        chatForMedia(chatId).data.customerId ==
          chatForMedia(chatId).data.participantIds[0] &&
        chatForMedia(chatId).data.providerId ==
          chatForMedia(chatId).data.participantIds[1] &&
        chatId == "chat_" + chatForMedia(chatId).data.participantIds[0] +
          "_" + chatForMedia(chatId).data.participantIds[1] &&
        request.auth.uid in chatForMedia(chatId).data.participantIds;
    }

    function isSupportedImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function hasSupportedImageExtension(fileName) {
      return fileName.matches('(?i).+\\.(jpg|jpeg|png|webp)$');
    }

    function isSupportedOfferWallImage(fileName) {
      return isSupportedImage() || hasSupportedImageExtension(fileName);
    }

    function isSupportedVerificationDocument() {
      return isSupportedImage() ||
        request.resource.contentType == 'application/pdf';
    }

    function isMaxFiveMb() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isMaxTenMb() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function verificationDocument(userId) {
      return firestore.get(
        /databases/(default)/documents/users/$(userId)/providerVerification/main
      );
    }

    function canStartVerificationSubmission(userId) {
      return !firestore.exists(
        /databases/(default)/documents/users/$(userId)/providerVerification/main
      ) || verificationDocument(userId).data.status in ['rejected', 'notSubmitted'];
    }

    function submissionIsNotReferenced(userId, submissionId) {
      return !firestore.exists(
        /databases/(default)/documents/users/$(userId)/providerVerification/main
      ) || verificationDocument(userId).data.submissionId != submissionId;
    }

    function canUploadBookingDisputeEvidence(bookingId, userId) {
      return isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb() &&
        !exists(/databases/(default)/documents/disputes/$(bookingId)) &&
        firestore.get(
          /databases/(default)/documents/bookings/$(bookingId)
        ).data.parentId == request.auth.uid &&
        firestore.get(
          /databases/(default)/documents/bookings/$(bookingId)
        ).data.state == 'COMPLETED_PENDING_REVIEW';
    }

    function canReadBookingDisputeEvidence(bookingId, userId) {
      return isOwner(userId) ||
        (
          signedIn() &&
          exists(/databases/(default)/documents/disputes/$(bookingId)) &&
          (
            firestore.get(
              /databases/(default)/documents/disputes/$(bookingId)
            ).data.customerId == request.auth.uid ||
            firestore.get(
              /databases/(default)/documents/disputes/$(bookingId)
            ).data.providerId == request.auth.uid ||
            isAdmin()
          )
        );
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /users/{userId}/services/{serviceId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /users/{userId}/pets/{petId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /disputes/{bookingId}/evidence/{userId}/{fileName} {
      allow read: if canReadBookingDisputeEvidence(bookingId, userId);
      allow create, update: if canUploadBookingDisputeEvidence(bookingId, userId);
      allow delete: if canUploadBookingDisputeEvidence(bookingId, userId);
    }

    match /socialPosts/{userId}/{postId}/{folder}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) &&
        folder in ['images', 'thumbs'] &&
        isSupportedImage() &&
        isMaxFiveMb();
      allow delete: if isOwner(userId) &&
        folder in ['images', 'thumbs'];
    }

    match /chatMedia/{chatId}/{messageId}/image.jpg {
      allow get: if isChatMediaParticipant(chatId) || canMonitorChatMedia();
      allow list: if false;
      allow create: if isChatMediaParticipant(chatId) &&
        resource == null &&
        messageId.matches('^[A-Za-z0-9]{20}$') &&
        chatForMedia(chatId).data.status == "active" &&
        request.resource.contentType == "image/jpeg" &&
        request.resource.size > 0 &&
        request.resource.size <= 3 * 1024 * 1024 &&
        request.resource.metadata.chatId == chatId &&
        request.resource.metadata.messageId == messageId &&
        request.resource.metadata.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if isChatMediaParticipant(chatId) &&
        resource.metadata.senderId == request.auth.uid &&
        !firestore.exists(
          /databases/(default)/documents/chats/$(chatId)/messages/$(messageId)
        );
    }

    match /providerVerification/{userId}/identity/{fileName} {
      allow read: if isOwner(userId) || canReviewProviderVerificationDocuments();
      // Legacy submitted evidence is immutable. Server cleanup uses Admin SDK.
      allow create, update, delete: if false;
    }

    match /providerVerification/{userId}/identity/{submissionId}/{fileName} {
      allow read: if isOwner(userId) || canReviewProviderVerificationDocuments();
      allow create: if isOwner(userId) &&
        canStartVerificationSubmission(userId) &&
        isSupportedVerificationDocument() &&
        isMaxTenMb();
      allow update: if false;
      // This supports cleanup after a failed Firestore submission while making
      // the version immutable as soon as its submissionId is referenced.
      allow delete: if isOwner(userId) &&
        submissionIsNotReferenced(userId, submissionId);
    }

    match /supportTickets/{userId}/{ticketId}/{fileName} {
      allow read: if (
        isOwner(userId) &&
        firestore.get(
          /databases/(default)/documents/supportTickets/$(ticketId)
        ).data.userId == userId
      ) || canManageSupportTickets();
      allow create, update: if isOwner(userId) &&
        firestore.get(
          /databases/(default)/documents/supportTickets/$(ticketId)
        ).data.userId == userId &&
        isSupportedImage() &&
        isMaxFiveMb();
      allow delete: if isOwner(userId) &&
        firestore.get(
          /databases/(default)/documents/supportTickets/$(ticketId)
        ).data.userId == userId;
    }

    match /offerWalls/{campaignId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if canManageOfferWalls() &&
        isSupportedOfferWallImage(fileName) &&
        isMaxFiveMb();
      allow delete: if canManageOfferWalls();
    }
    // Download-token URLs generated by Firebase Storage remain suitable for
    // email clients. Only Super Admins can create, replace, or delete assets.
    match /marketingCampaigns/{campaignId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create, update: if canManageMarketingCampaigns() &&
        isSupportedImage() &&
        hasSupportedImageExtension(fileName) &&
        isMaxFiveMb();
      allow delete: if canManageMarketingCampaigns();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
