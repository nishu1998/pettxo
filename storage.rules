rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin", "financeAdmin"];
    }

    function canManageOfferWalls() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "financeAdmin"];
    }

    function canReviewProviderVerificationDocuments() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin"];
    }

    function canManageSupportTickets() {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole in ["superAdmin", "customerSupportAdmin"];
    }

    function isSupportedImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function hasSupportedImageExtension(fileName) {
      return fileName.matches('(?i).+\\.(jpg|jpeg|png|webp)$');
    }

    function isSupportedOfferWallImage(fileName) {
      return isSupportedImage() || hasSupportedImageExtension(fileName);
    }

    function isSupportedVerificationDocument() {
      return isSupportedImage() ||
        request.resource.contentType == 'application/pdf';
    }

    function isMaxFiveMb() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isMaxTenMb() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /users/{userId}/services/{serviceId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /users/{userId}/pets/{petId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /disputes/{disputeId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(userId) &&
        isSupportedImage() &&
        isMaxFiveMb();
    }

    match /socialPosts/{userId}/{postId}/{folder}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) &&
        folder in ['images', 'thumbs'] &&
        isSupportedImage() &&
        isMaxFiveMb();
      allow delete: if isOwner(userId) &&
        folder in ['images', 'thumbs'];
    }

    match /providerVerification/{userId}/identity/{fileName} {
      allow read: if isOwner(userId) || canReviewProviderVerificationDocuments();
      allow create, update: if isOwner(userId) &&
        isSupportedVerificationDocument() &&
        isMaxTenMb();
      allow delete: if isOwner(userId);
    }

    match /supportTickets/{userId}/{ticketId}/{fileName} {
      allow read: if (
        isOwner(userId) &&
        firestore.get(
          /databases/(default)/documents/supportTickets/$(ticketId)
        ).data.userId == userId
      ) || canManageSupportTickets();
      allow create, update: if isOwner(userId) &&
        firestore.get(
          /databases/(default)/documents/supportTickets/$(ticketId)
        ).data.userId == userId &&
        isSupportedImage() &&
        isMaxFiveMb();
      allow delete: if isOwner(userId) &&
        firestore.get(
          /databases/(default)/documents/supportTickets/$(ticketId)
        ).data.userId == userId;
    }

    match /offerWalls/{campaignId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if canManageOfferWalls() &&
        isSupportedOfferWallImage(fileName) &&
        isMaxFiveMb();
      allow delete: if canManageOfferWalls();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
